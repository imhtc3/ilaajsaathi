# Everything is optional. With no keys the agent runs fully on built-in rules + free OpenStreetMap.

# --- LLM (pick one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=              # any OpenAI-compatible API (OpenAI, Groq, Gemini OpenAI endpoint...)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# --- Google Maps Platform (recommended) ---
# Enable in Google Cloud console: Places API (New), Geocoding API, Routes API. Restrict the key to these APIs.
GOOGLE_MAPS_API_KEY=

# Free OpenStreetMap fallback (Nominatim + Overpass). Set 0 to use only offline data.
ILAAJ_USE_OSM=1
PORT=8000
